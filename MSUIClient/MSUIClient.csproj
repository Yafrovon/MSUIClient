<Project Sdk="Microsoft.NET.Sdk">

	<!-- ══════════════════════════════════════════════════════════════════════
	     MSUI Client — native C# client for VMaNGOS 1.12.1 (client build 5875).

	     No source/project reference to MangosSuperUI is required; live realm
	     metadata is consumed through its read-only HTTP API when configured.
	     The Blizzard format readers live in Formats/ as this project's own
	     source. They were originally written for the SuperUI web app; copies
	     here are independent and will drift. That is the deliberate trade for
	     an independent project — these are 2006 file formats that do not change,
	     so drift costs little, but a real bug fix does have to be applied twice.

	     Reads the WoW MPQs directly off local disk with no asset server or bake
	     step. Game assets never travel over HTTP. Works natively in WoW world
	     space (X north, Y west, Z up) with no coordinate conversion anywhere.
	     ══════════════════════════════════════════════════════════════════════ -->

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>MSUIClient</AssemblyName>
		<RootNamespace>MSUIClient</RootNamespace>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<InvariantGlobalization>true</InvariantGlobalization>
		<PackageLicenseExpression>GPL-2.0-or-later</PackageLicenseExpression>
		<Copyright>Copyright (C) 2026 MSUIClient contributors</Copyright>

		<!-- Windows-only client. With no RID this publishes portable, which copies
		     every platform's natives out of every package - 21 RIDs and ~450 MB of
		     runtimes/, none of which this client can run. Pinning win-x64 keeps only
		     the natives that load here. AppendRuntimeIdentifierToOutputPath=false
		     holds the output at bin/<cfg>/net8.0/ instead of moving it under a
		     win-x64/ subfolder, so existing paths and launch habits still work. -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<!-- The SDK appends the RID to the publish path on its own, independently of
		     the flag above. Pin it so the publish folder stays at the path it has
		     always been at. The condition lets an explicit -o still win. -->
		<PublishDir Condition="'$(PublishDir)' == ''">bin\$(Configuration)\$(TargetFramework)\publish\</PublishDir>

		<!-- Console stays attached in Debug so parser output is visible; hidden
		     in Release so the shipped client doesn't open a terminal beside it. -->
		<OutputType Condition="'$(Configuration)' == 'Release'">WinExe</OutputType>

		<!-- The MSUI crest (shared with MangosSuperUI's favicon) as the exe icon;
		     the window icon is set at runtime from the embedded PNG below. -->
		<ApplicationIcon>Assets\msui-icon.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<!-- Windowing + GL + input. Silk.NET is a binding layer, not an engine —
		     we own the renderer, which is what the painterly render mode needs
		     (full control of shaders and the post stack). -->
		<PackageReference Include="NLayer" Version="2.0.1" />
		<PackageReference Include="Silk.NET.Windowing" Version="2.21.0" />
		<PackageReference Include="Silk.NET.OpenGL" Version="2.21.0" />
		<PackageReference Include="Silk.NET.Input" Version="2.21.0" />
		<PackageReference Include="Silk.NET.Maths" Version="2.21.0" />
		<PackageReference Include="Silk.NET.OpenGL.Extensions.ImGui" Version="2.21.0" />

		<!-- Skia is load-bearing well beyond AdtTerrainReader now: portrait render
		     targets, quest-helper glyph rasterizing and marker art, and BLP writing
		     all go through it, so the dependency is not droppable. The Linux native
		     assets package is gone - it shipped libSkiaSharp for eleven Linux RIDs
		     (musl, loongarch64, riscv64 among them) that a Windows client never loads. -->
		<PackageReference Include="SkiaSharp" Version="3.119.2" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Assets\msui-icon.png" />
		<EmbeddedResource Include="Assets\UI\PartyChain\party-chain-linked.png"
			LogicalName="MSUIClient.Assets.UI.PartyChain.party-chain-linked.png" />
		<EmbeddedResource Include="Assets\UI\PartyChain\party-chain-unlinked.png"
			LogicalName="MSUIClient.Assets.UI.PartyChain.party-chain-unlinked.png" />
		<EmbeddedResource Include="Assets\UI\PartyChain\party-chain-world-hold.png"
			LogicalName="MSUIClient.Assets.UI.PartyChain.party-chain-world-hold.png" />
		<EmbeddedResource Include="Data/vmangos-commands.tsv"
			LogicalName="MSUIClient.Data.vmangos-commands.tsv" />
		<EmbeddedResource Include="Data/vanilla-spell-rules.json"
			LogicalName="MSUIClient.Data.vanilla-spell-rules.json" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\LICENSE" Link="LICENSE.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Update="client-config.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Update="Shaders\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Update="Assets\ThirdParty\*.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="World\Particles\" />
	</ItemGroup>

	<!-- SkiaSharp's Windows native packages ship an ~80 MB libSkiaSharp.pdb next
	     to each DLL. Nothing here debugs into native Skia, so drop every .pdb that
	     came from a package. The empty NuGetPackageId test spares MSUIClient.pdb,
	     which is ours and still wanted for managed stack traces. -->
	<Target Name="TrimPackageSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
		<ItemGroup>
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
											  Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb' and '%(ResolvedFileToPublish.NuGetPackageId)' != ''" />
		</ItemGroup>
	</Target>

	<!-- Same symbols, other code path: a plain build copies them into bin/ through
	     ReferenceCopyLocalPaths, which publish's trim above never sees. -->
	<Target Name="TrimPackageSymbolsFromBuild" AfterTargets="ResolveReferences">
		<ItemGroup>
			<ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
												  Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.pdb' and '%(ReferenceCopyLocalPaths.NuGetPackageId)' != ''" />
		</ItemGroup>
	</Target>

<ItemGroup><EmbeddedResource Include="../encounter-definitions/onyxia.json" LogicalName="MSUIClient.Encounters.onyxia.json" /></ItemGroup>
<ItemGroup><EmbeddedResource Include="Data/encounter-boss-catalog.json" LogicalName="MSUIClient.Encounters.boss-catalog.json" /></ItemGroup>
<ItemGroup><EmbeddedResource Include="Data/tuning-fields.json" LogicalName="MSUIClient.Encounters.tuning-fields.json" /></ItemGroup>
</Project>
