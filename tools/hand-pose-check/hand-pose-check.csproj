<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup Condition="'$(ClientAssembly)' == ''">
    <ProjectReference Include="../../MSUIClient/MSUIClient.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(ClientAssembly)' != ''">
    <Reference Include="MSUIClient"><HintPath>$(ClientAssembly)</HintPath></Reference>
  </ItemGroup>
</Project>
